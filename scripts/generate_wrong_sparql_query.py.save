# generate_wrong_sparql_query.py

```python
#!/usr/bin/env python3
"""
Generate incorrect SPARQL queries with a fixed error-type distribution.

Input:
    A JSON file containing an array of objects. Each object must contain:
    - id
    - question
    - sparql_gold

Outputs:
    1. A CSV file containing the full table, including the prompt column.
    2. A JSON file containing only:
       - id
       - question
       - sparql_wrong
       - sparql_gold
       - error_types

Usage:
    python3 generate_wrong_sparql_query.py \
        --input /home/kyan/stage/Datasets/Extracted_en_question_query/extracted_qald_9_plus_train.json \
        --output_csv /home/kyan/stage/Datasets/Generated_wrong_sparql_datasets/training_set_with_errors.csv \
        --output_json /home/kyan/stage/Datasets/Generated_wrong_sparql_datasets/training_set_with_errors.json \
        --model gpt-4.1
"""

import argparse
import json
import os
import random
import time
from typing import Dict, Tuple

import pandas as pd
from tqdm import tqdm
from openai import OpenAI


SEMANTIC_PROMPT = """
You are an expert in SPARQL and DBpedia.

Your task is to generate ONE intentionally incorrect SPARQL query from a correct golden SPARQL query.

Semantic errors are errors that violate the meaning or ontology constraints of the knowledge graph.

Examples of semantic errors include:
- incorrect URI
- incorrect property
- incorrect class
- hallucinated entity or property
- wrong literal or resource type
- malformed FILTER condition
- logically inconsistent triple patterns
- ontology constraint violations

Rules:
- Introduce EXACTLY ONE semantic error
- Keep the query syntactically valid
- Keep the query structure as close as possible to the original
- Do NOT introduce syntax errors
- Do NOT introduce structural errors
- The generated query should remain realistic and plausible
- Return ONLY valid JSON
- Do NOT include explanations or comments

Input:
{{
  "id": "{id}",
  "question": "{question}",
  "sparql_gold": "{sparql_gold}"
}}

Output format:
{{
  "id": "{id}",
  "question": "{question}",
  "sparql_wrong": "<generated incorrect SPARQL query>",
  "sparql_gold": "{sparql_gold}",
  "error_types": ["semantic"]
}}
""".strip()


SYNTAX_PROMPT = """
You are an expert in SPARQL and DBpedia.

Your task is to generate ONE intentionally incorrect SPARQL query from a correct golden SPARQL query.

Syntactic errors are violations of SPARQL grammar rules that prevent the query from being parsed correctly.

Examples of syntactic errors include:
- missing or mismatched braces
- missing parentheses
- malformed SELECT clause
- incorrect WHERE placement
- malformed PREFIX declaration
- incorrect clause ordering
- undeclared variable
- general SPARQL grammar violations

Rules:
- Introduce EXACTLY ONE syntactic error
- Do NOT introduce semantic errors
- Do NOT introduce structural errors
- Keep the query as close as possible to the original
- Return ONLY valid JSON
- Do NOT include explanations or comments

Input:
{{
  "id": "{id}",
  "question": "{question}",
  "sparql_gold": "{sparql_gold}"
}}

Output format:
{{
  "id": "{id}",
  "question": "{question}",
  "sparql_wrong": "<generated incorrect SPARQL query>",
  "sparql_gold": "{sparql_gold}",
  "error_types": ["syntax"]
}}
""".strip()


STRUCTURAL_PROMPT = """
You are an expert in SPARQL and DBpedia.

Your task is to generate ONE intentionally incorrect SPARQL query from a correct golden SPARQL query.

Structural errors affect the internal structure of triples or the composition of graph patterns.

Examples of structural errors include:
- triple flip (subject/object inversion)
- incorrect joins between triples
- disconnected graph patterns
- missing triple components
- extra triple components
- malformed triple composition

Rules:
- Introduce EXACTLY ONE structural error
- Keep the query syntactically valid
- Do NOT introduce syntax errors
- Do NOT introduce semantic errors
- Keep the query structure close to the original
- The generated query should remain realistic and plausible
- Return ONLY valid JSON
- Do NOT include explanations or comments

Input:
{{
  "id": "{id}",
  "question": "{question}",
  "sparql_gold": "{sparql_gold}"
}}

Output format:
{{
  "id": "{id}",
  "question": "{question}",
  "sparql_wrong": "<generated incorrect SPARQL query>",
  "sparql_gold": "{sparql_gold}",
  "error_types": ["structural"]
}}
""".strip()


PROMPTS = {
    "semantic": SEMANTIC_PROMPT,
    "syntax": SYNTAX_PROMPT,
    "structural": STRUCTURAL_PROMPT,
}


TARGET_COUNTS = {
    "syntax": 82,
    "semantic": 285,
    "structural": 41,
}


def assign_error_types(n_rows: int, seed: int = 42):
    """
    Randomly assign error types according to TARGET_COUNTS.
    The total number of rows must match the sum of TARGET_COUNTS.
    """
    total_target = sum(TARGET_COUNTS.values())

    if total_target != n_rows:
        raise ValueError(
            f"Target counts sum to {total_target}, but input contains {n_rows} rows."
        )

    assignments = []
    for error_type, count in TARGET_COUNTS.items():
        assignments.extend([error_type] * count)

    random.seed(seed)
    random.shuffle(assignments)

    return assignments


def call_model(client: OpenAI, model: str, prompt: str) -> Tuple[Dict, str]:
    """
    Call the OpenAI model and parse the JSON response.

    Returns:
        parsed_json: Parsed Python dictionary.
        raw_text: Raw response text.
    """
    response = client.responses.create(
        model=model,
        input=prompt,
    )

    raw_text = response.output_text.strip()
    parsed_json = json.loads(raw_text)

    return parsed_json, raw_text


def escape_braces(text: str) -> str:
    """
    Escape curly braces to make the string safe for str.format().
    """
    return text.replace("{", "{{").replace("}", "}}")


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--input",
        required=True,
        help="Input JSON file containing an array of objects.",
    )

    parser.add_argument(
        "--output_csv",
        required=True,
        help="Path to save the full CSV table.",
    )

    parser.add_argument(
        "--output_json",
        required=True,
        help="Path to save the final JSON file.",
    )

    parser.add_argument(
        "--model",
        default="gpt-4.1",
        help="OpenAI model name.",
    )

    parser.add_argument(
        "--seed",
        type=int,
        default=42,
        help="Random seed used for error-type assignment.",
    )

    parser.add_argument(
        "--sleep",
        type=float,
        default=0.5,
        help="Sleep time between API calls in seconds.",
    )

    args = parser.parse_args()

    # Check whether the API key is available.
    if "OPENAI_API_KEY" not in os.environ:
        raise RuntimeError("Please set the OPENAI_API_KEY environment variable.")

    # Create output directories if they do not exist.
    output_csv_dir = os.path.dirname(args.output_csv)
    output_json_dir = os.path.dirname(args.output_json)

    if output_csv_dir:
        os.makedirs(output_csv_dir, exist_ok=True)

    if output_json_dir:
        os.makedirs(output_json_dir, exist_ok=True)

    # Read the input JSON file.
    df = pd.read_json(args.input)

    # Validate required columns.
    required_columns = {"id", "question", "sparql_gold"}
    missing_columns = required_columns - set(df.columns)

    if missing_columns:
        raise ValueError(f"Missing required columns: {sorted(missing_columns)}")

    # Assign one target error type to each row.
    df["assigned_error_type"] = assign_error_types(len(df), seed=args.seed)

    # Initialize the OpenAI client.
    client = OpenAI()

    # Containers for generated results.
    prompt_list = []
    sparql_wrong_list = []
    error_types_list = []
    raw_json_list = []
    valid_generation_list = []
    issue_list = []

    # Process each row.
    for _, row in tqdm(df.iterrows(), total=len(df)):
        error_type = row["assigned_error_type"]

        # Build the full prompt for this example.
        prompt = PROMPTS[error_type].format(
            id=escape_braces(str(row["id"])),
            question=escape_braces(str(row["question"])),
            sparql_gold=escape_braces(str(row["sparql_gold"])),
        )

        # Save the prompt so it will appear in the CSV output.
        prompt_list.append(prompt)

        try:
            parsed, raw_text = call_model(
                client=client,
                model=args.model,
                prompt=prompt,
            )

            sparql_wrong = parsed.get("sparql_wrong", "")
            returned_error_types = parsed.get("error_types", [error_type])

            sparql_wrong_list.append(sparql_wrong)
            error_types_list.append(returned_error_types)
            raw_json_list.append(raw_text)

            if str(sparql_wrong).strip():
                valid_generation_list.append("yes")
                issue_list.append("none")
            else:
                valid_generation_list.append("no")
                issue_list.append("empty_sparql_wrong")

        except Exception as e:
            print(f"Error on id={row['id']}: {e}")

            # Use fallback values when generation fails.
            sparql_wrong_list.append("")
            error_types_list.append([error_type])
            raw_json_list.append("")
            valid_generation_list.append("no")
            issue_list.append(str(e))

        # Sleep to reduce the request rate.
        time.sleep(args.sleep)

    # Add generated columns to the DataFrame.
    df["prompt"] = prompt_list
    df["sparql_wrong"] = sparql_wrong_list
    df["error_types"] = error_types_list
    df["raw_json"] = raw_json_list
    df["valid_generation"] = valid_generation_list
    df["issue"] = issue_list

    # Save the full table to CSV.
    df.to_csv(args.output_csv, index=False)

    # Select only the fields required for the JSON output.
    json_columns = [
        "id",
        "question",
        "sparql_wrong",
        "sparql_gold",
        "error_types",
    ]

    # Save the selected fields to JSON.
    df[json_columns].to_json(
        args.output_json,
        orient="records",
        force_ascii=False,
        indent=2,
    )

    print(f"Saved CSV to {args.output_csv}")
    print(f"Saved JSON to {args.output_json}")


if __name__ == "__main__":
    main()
```

